    CAST(ISNULL(CustomerID, '') AS VARCHAR(50)) AS customer_id,
    CAST(ISNULL(City, '') AS VARCHAR(100)) AS city,
    CAST(ISNULL(Gender, '') AS VARCHAR(20)) AS gender,
    CAST(ISNULL([Senior Citizen], '') AS VARCHAR(10)) AS senior_citizen,
    CAST(ISNULL(Partner, '') AS VARCHAR(10)) AS partner,
    CAST(ISNULL(Dependents, '') AS VARCHAR(10)) AS dependents
FROM dbo.telco_churn_data</property>
