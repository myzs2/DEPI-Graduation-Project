                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(ISNULL(CustomerID, '') AS VARCHAR(50))           AS customer_id,

    CAST(ISNULL([Phone Service], '') AS VARCHAR(20))      AS phone_service,
    CAST(ISNULL([Multiple Lines], '') AS VARCHAR(30))     AS multiple_lines,
    CAST(ISNULL([Internet Service], '') AS VARCHAR(50))   AS internet_service,
    CAST(ISNULL([Online Security], '') AS VARCHAR(30))    AS online_security,
    CAST(ISNULL([Online Backup], '') AS VARCHAR(30))      AS online_backup,
    CAST(ISNULL([Device Protection], '') AS VARCHAR(30))  AS device_protection,
    CAST(ISNULL([Tech Support], '') AS VARCHAR(30))       AS tech_support,
    CAST(ISNULL([Streaming TV], '') AS VARCHAR(30))       AS streaming_tv,
    CAST(ISNULL([Streaming Movies], '') AS VARCHAR(30))   AS streaming_movies,

    CAST(ISNULL([Contract], '') AS VARCHAR(50))           AS contract_type,
    CAST(ISNULL([Payment Method], '') AS VARCHAR(50))     AS payment_method,
    CAST(ISNULL([Paperless Billing], '') AS VARCHAR(10))  AS paperless_billing,

    CAST(ISNULL([Tenure Months], 0) AS INT)               AS tenure_months,
    CAST(ISNULL([Monthly Charges], 0) AS DECIMAL(10,2))   AS monthly_charges,
    CAST(ISNULL([Total Charges], 0) AS DECIMAL(12,2))     AS total_charges,

    CAST(ISNULL([Churn Label], '') AS VARCHAR(10))        AS churn_label,
    CAST(ISNULL([Churn Score], 0) AS INT)                 AS churn_score,
    CAST(ISNULL(CLTV, 0) AS DECIMAL(12,2))                AS cltv

FROM dbo.telco_churn_data;SELECT
    CAST(ISNULL(CustomerID, '') AS VARCHAR(50))           AS customer_id,

    CAST(ISNULL([Phone Service], '') AS VARCHAR(20))      AS phone_service,
    CAST(ISNULL([Multiple Lines], '') AS VARCHAR(30))     AS multiple_lines,
    CAST(ISNULL([Internet Service], '') AS VARCHAR(50))   AS internet_service,
    CAST(ISNULL([Online Security], '') AS VARCHAR(30))    AS online_security,
    CAST(ISNULL([Online Backup], '') AS VARCHAR(30))      AS online_backup,
    CAST(ISNULL([Device Protection], '') AS VARCHAR(30))  AS device_protection,
    CAST(ISNULL([Tech Support], '') AS VARCHAR(30))       AS tech_support,
    CAST(ISNULL([Streaming TV], '') AS VARCHAR(30))       AS streaming_tv,
    CAST(ISNULL([Streaming Movies], '') AS VARCHAR(30))   AS streaming_movies,

    CAST(ISNULL([Contract], '') AS VARCHAR(50))           AS contract_type,
    CAST(ISNULL([Payment Method], '') AS VARCHAR(50))     AS payment_method,
    CAST(ISNULL([Paperless Billing], '') AS VARCHAR(10))  AS paperless_billing,

    CAST(ISNULL([Tenure Months], 0) AS INT)               AS tenure_months,
    CAST(ISNULL([Monthly Charges], 0) AS DECIMAL(10,2))   AS monthly_charges,
    CAST(ISNULL([Total Charges], 0) AS DECIMAL(12,2))     AS total_charges,

    CAST(ISNULL([Churn Label], '') AS VARCHAR(10))        AS churn_label,
    CAST(ISNULL([Churn Score], 0) AS INT)                 AS churn_score,
    CAST(ISNULL(CLTV, 0) AS DECIMAL(12,2))                AS cltv

FROM dbo.telco_churn_data;</property>
